{
  "name": "dsh-prompt-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optimize the composer draft into a structured prompt through the harness LLM, reusing the Prompt Optimizer (oss-prompt-optimizer) rewrite engine.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.3 <0.3.0-0"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dependencies": {
    "oss-prompt-optimizer": "^1.13.1"
  }
}
